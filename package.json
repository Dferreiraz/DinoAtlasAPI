{
  "name": "dinoatlas",
  "version": "2.5.0",
  "description": "Uma API REST pública e gratuita para dados estruturados sobre dinossauros e informações paleontológicas relacionadas.",
  "main": "server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:data": "jest tests/data",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "api",
    "dinosaurs",
    "paleontology",
    "rest",
    "nodejs",
    "express",
    "source-available",
    "atlas"
  ],
  "author": "Davi Ferreira",
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "body-parser": "1.20.9",
    "qs": "6.17.1",
    "ip-address": "10.7.6"
  }
}
